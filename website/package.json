{
  "name": "png-to-nbt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": "26.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test:fixtures": "bun run tests/run.mts",
    "test:invariants": "bun run tests/invariants.mts",
    "test:all": "bun run test:invariants && bun run test:fixtures",
    "audit:mapcolors": "node scripts/audit-mapcolors.mjs",
    "audit:mapcolors:strict": "node scripts/audit-mapcolors.mjs --strict-missing",
    "build:block-icons": "python3 scripts/generate-stateful-icon-overrides.py && node scripts/build-block-icon-files.mjs && python3 scripts/postprocess-block-icon-files.py && python3 scripts/render-shulker-icons.py && python3 scripts/build-icon-atlases.py"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
