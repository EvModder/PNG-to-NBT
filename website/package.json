{
  "name": "png-to-nbt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3",
    "node": "26.11.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test:typecheck": "tsc -p tests",
    "test:fixtures": "bun run tests/run.mts",
    "test:invariants": "bun run tests/invariants.mts",
    "test:versions": "bun run tests/minecraftVersions.mts",
    "test:presets": "bun run tests/codecPreset.mts",
    "test:pixel-art": "bun run tests/pixelArtScaling.mts",
    "test:images-browser": "node tests/imageImportBrowser.mjs",
    "test:workers": "bun run tests/workerPool.mts",
    "test:geometry-browser": "node tests/geometryWorkerBrowser.mjs",
    "test:wiki": "bun ../scripts/audit-block-wiki.mjs --offline",
    "test:all": "bun run test:typecheck && bun run test:invariants && bun run test:versions && bun run test:presets && bun run test:pixel-art && bun run test:workers && bun run test:wiki && bun run test:fixtures",
    "audit:block-wiki": "bun ../scripts/audit-block-wiki.mjs",
    "audit:mapcolors": "node ../scripts/audit-mapcolors.mjs",
    "audit:mapcolors:strict": "node ../scripts/audit-mapcolors.mjs --strict-missing",
    "build:block-icons": "python3 ../scripts/generate-stateful-icon-overrides.py && node ../scripts/build-block-icon-files.mjs && python3 ../scripts/postprocess-block-icon-files.py && python3 ../scripts/render-shulker-icons.py && python3 ../scripts/build-icon-atlases.py"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
